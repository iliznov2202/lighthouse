NODE_ENV=development
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_USER=mayak
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=mayak_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mayak:replace-with-local-database-password@127.0.0.1:5432/mayak_dev?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Required only for explicitly running the development seed. Never use a real password here.
SEED_USER_PASSWORD=replace-with-a-local-test-password
