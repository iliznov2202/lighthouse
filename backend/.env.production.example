NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Exactly one proxy hop. Safe only with no published API port; see compose.production.yml.
TRUST_PROXY=1
FRONTEND_ORIGINS=https://app.example.com
API_DOMAIN=api.example.com
POSTGRES_USER=mayak
POSTGRES_PASSWORD=replace-with-production-database-password
POSTGRES_DB=mayak_prod
DATABASE_URL=postgresql://mayak:replace-with-production-database-password@postgres:5432/mayak_prod?schema=public
JWT_ACCESS_SECRET=replace-with-a-new-random-production-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
